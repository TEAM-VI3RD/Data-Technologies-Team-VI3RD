# PostgreSQL for local development outside Docker.
# Docker Compose overrides DB_HOST and DB_PORT for the backend container.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=webshop
DB_USER=webshop
DB_PASSWORD=change-me

# MongoDB for local development outside Docker.
# Docker Compose overrides MONGO_URI for the backend container.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=webshop_payments

# Use a long random value in production or shared test environments.
JWT_SECRET=change-me-in-production
